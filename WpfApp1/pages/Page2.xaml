<Page x:Class="WpfApp1.pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Page2">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Шаг 2: Выберите Цвет и Дополнительные Опции" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Цвет автомобиля (доплата):" Margin="0,10,0,5"/>
            <ComboBox x:Name="CmbColor" DisplayMemberPath="Name" 
                      SelectionChanged="CmbColor_SelectionChanged" Height="30" Width="300" HorizontalAlignment="Left"/>

            <TextBlock Text="Дополнительные опции:" Margin="0,20,0,5"/>

            <ListBox x:Name="ListOptions" Margin="0,0,0,20" BorderThickness="1" MaxHeight="250" SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                  Checked="Option_CheckChanged" Unchecked="Option_CheckChanged">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Price, StringFormat={}(+ {0:N0} руб.)}" Foreground="Gray"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="TxtCurrentPrice" FontSize="16" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Назад" Click="BtnBack_Click" Margin="0,0,10,0" Padding="15,5"/>
            <Button Content="Далее" Click="BtnNext_Click" x:Name="BtnNext" IsEnabled="False" Padding="15,5"/>
        </StackPanel>
    </Grid>
</Page>