<Page x:Class="WpfApp1.pages.Page4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Page4"
      Loaded="Page_Loaded">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Шаг 4: Контактные данные" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Width="400" HorizontalAlignment="Left">
            <TextBlock Text="ФИО:" Margin="0,10,0,5"/>
            <TextBox x:Name="TxtName" Height="30" TextChanged="Input_Changed"/>

            <TextBlock Text="Телефон:" Margin="0,10,0,5"/>
            <TextBox x:Name="TxtPhone" Height="30" TextChanged="Input_Changed"/>

            <TextBlock Text="Email:" Margin="0,10,0,5"/>
            <TextBox x:Name="TxtEmail" Height="30" TextChanged="Input_Changed"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Назад" Click="BtnBack_Click" Margin="0,0,10,0" Padding="15,5"/>
            <Button x:Name="BtnNext" Content="К Сводке" Click="BtnNext_Click" Padding="15,5" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Page>