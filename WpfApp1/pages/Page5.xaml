<Page x:Class="WpfApp1.pages.Page5_Summary"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Page5_Summary">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Шаг 5: Итоговая Сводка и Оформление" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="SummaryPanel" Margin="0,10,0,10">
                </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,20,0,0">
            <Button Content="Назад (Изменить)" Click="BtnBack_Click" Margin="0,0,10,0" Padding="15,5"/>
            <Button Content="ОФОРМИТЬ ЗАКАЗ" Click="BtnFinish_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold" Padding="20,8"/>
        </StackPanel>
    </Grid>
</Page>