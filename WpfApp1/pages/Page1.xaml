<Page x:Class="WpfApp1.pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Шаг 1: Выбор Модели">
    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="Шаг 1: Выберите Модель и Тип Двигателя" Style="{StaticResource HeaderStyle}"/>
            
            <TextBlock Text="Модель автомобиля:" Margin="0,10,0,5"/>
            <ComboBox x:Name="CmbModel" DisplayMemberPath="Name" 
                      SelectionChanged="CmbModel_SelectionChanged" Height="30" Width="300" HorizontalAlignment="Left"/>
            
            <TextBlock Text="Тип двигателя (доплата):" Margin="0,20,0,5"/>
            <ComboBox x:Name="CmbEngine" DisplayMemberPath="Type" 
                      SelectionChanged="CmbEngine_SelectionChanged" Height="30" Width="300" HorizontalAlignment="Left"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Далее" Click="BtnNext_Click" Style="{StaticResource NavButtonStyle}"
                    x:Name="BtnNext" IsEnabled="False"/> 
            </StackPanel>
    </Grid>
</Page>