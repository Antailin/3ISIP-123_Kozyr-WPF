<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#2c3e50" Padding="12" Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Кинотеатр" 
                           Foreground="White" 
                           FontSize="20" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center" 
                           Margin="0,0,30,0"/>

                <TextBox x:Name="SearchBox" 
                         Width="240" 
                         Margin="0,0,15,0" 
                         VerticalContentAlignment="Center" 
                         TextChanged="SearchBox_TextChanged"/>

                <ComboBox x:Name="SortCombo" 
                          Width="140" 
                          Margin="0,0,20,0" 
                          SelectionChanged="SortCombo_SelectionChanged">
                    <ComboBoxItem Content="По названию"/>
                    <ComboBoxItem Content="По рейтингу"/>
                </ComboBox>

                <Button Content="Личный кабинет" 
                        Margin="0,0,10,0" 
                        Click="ProfileButton_Click"
                        Background="#3498db" 
                        Foreground="White"/>

                <Button Content="Вход" 
                        Margin="0,0,10,0" 
                        Click="LoginButton_Click"/>

                <Button Content="Регистрация" 
                        Click="RegisterButton_Click"/>
            </StackPanel>
        </Border>

        <Frame x:Name="MainFrame" 
               Grid.Row="1" 
               NavigationUIVisibility="Hidden"
               Background="White"/>
    </Grid>
    </Window>
